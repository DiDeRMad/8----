{
  "name": "cosmic-empire-game",
  "version": "1.0.0",
  "description": "Massive multiplayer online space strategy game with real-time combat and empire building",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "nodemon server/index.js",
    "test": "jest",
    "build": "npm run build:client",
    "build:client": "webpack --mode production",
    "dev:client": "webpack serve --mode development",
    "setup": "npm install && npm run init:db",
    "init:db": "node scripts/initDatabase.js"
  },
  "keywords": [
    "game",
    "multiplayer",
    "strategy",
    "space",
    "realtime",
    "online",
    "empire",
    "cosmic"
  ],
  "author": "Cosmic Empire Team",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "socket.io": "^4.7.4",
    "sqlite3": "^5.1.6",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "rate-limiter-flexible": "^3.0.8",
    "uuid": "^9.0.1",
    "lodash": "^4.17.21",
    "moment": "^2.29.4",
    "compression": "^1.7.4",
    "morgan": "^1.10.0",
    "dotenv": "^16.3.1",
    "validator": "^13.11.0",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "jest": "^29.7.0",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.15.1",
    "html-webpack-plugin": "^5.6.0",
    "css-loader": "^6.8.1",
    "style-loader": "^3.3.3",
    "file-loader": "^6.2.0",
    "url-loader": "^4.1.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}